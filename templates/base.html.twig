<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Auth App{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Auth App</a>
        <div class="navbar-nav ms-auto">
            {% if app.user %}
                <span class="nav-link text-white-50">{{ app.user.userIdentifier }}</span>
                <a class="nav-link" href="{{ path('app_logs') }}">Логи</a>
                <a class="nav-link" href="{{ path('app_logout') }}">Выход</a>
            {% else %}
                <a class="nav-link" href="{{ path('app_login') }}">Вход</a>
                <a class="nav-link" href="{{ path('app_register') }}">Регистрация</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
